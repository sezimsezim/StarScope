/* =========================================================
   STARSCOPE — Shared Design System
   Scientific Observatory × Futuristic Interface
   ========================================================= */

:root {
  --bg: #04060b;

  --panel: rgba(9, 16, 25, 0.8);
  --panel-strong: rgba(10, 18, 30, 0.94);

  --ink: #eaf3ff;
  --ink-soft: #8c9bb1;

  --line: rgba(234, 243, 255, 0.12);
  --line-strong: rgba(234, 243, 255, 0.24);

  --cyan: #6fe7dd;
  --blue: #4facfe;
  --purple: #d4b5ff;
  --gold: #f6d365;
  --amber: #ffb347;
  --rose: #ff6b6b;

  --shadow: rgba(111, 231, 221, 0.32);
}


/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}


html,
body {
  min-height: 100%;

  font-family:
    "JetBrains Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  background: var(--bg);
  color: var(--ink);
}


body {
  min-height: 100vh;

  position: relative;

  overflow: hidden;

  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}


button,
input {
  font: inherit;
}


/* =========================================================
   EXPLORE PAGE BACKGROUND
   ========================================================= */

.explore-page {
  background:
    radial-gradient(
      circle at 50% 30%,
      rgba(111, 231, 221, 0.08),
      transparent 26%
    ),
    radial-gradient(
      circle at 15% 20%,
      rgba(79, 172, 254, 0.08),
      transparent 24%
    ),
    #04060b;
}


/* =========================================================
   BACKGROUND GRID
   ========================================================= */

.space-background {
  position: fixed;

  inset: 0;

  pointer-events: none;

  background-image:
    linear-gradient(
      rgba(111, 231, 221, 0.04) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(111, 231, 221, 0.04) 1px,
      transparent 1px
    );

  background-size: 42px 42px;

  mask-image:
    radial-gradient(
      circle at center,
      black 35%,
      transparent 85%
    );
}


.space-background::after {
  content: "";

  position: absolute;

  inset: 0;

  background:
    radial-gradient(
      ellipse at center,
      transparent 48%,
      rgba(0, 0, 0, 0.58) 100%
    );
}


/* =========================================================
   TOP NAVIGATION
   ========================================================= */

.topbar,
.explore-header {
  position: fixed;

  top: 0;
  left: 0;
  right: 0;

  z-index: 50;

  display: flex;

  align-items: center;
  justify-content: space-between;

  padding: 26px 48px 0;
}


.brand,
.brand:visited,
.brand:active {
  color: var(--ink);

  text-decoration: none;

  font-size: 13px;

  font-weight: 700;

  letter-spacing: 0.28em;

  text-transform: uppercase;
}


.nav-links,
.explore-nav {
  display: flex;

  align-items: center;

  gap: 24px;
}


.nav-links a,
.nav-links a:visited,
.explore-nav a,
.explore-nav a:visited {
  color: var(--ink-soft);

  text-decoration: none;

  font-size: 11px;

  letter-spacing: 0.18em;

  transition:
    color 0.2s ease;
}


.nav-links a:hover,
.nav-links a.active,
.nav-links a.is-current,
.explore-nav a:hover,
.explore-nav a.is-current {
  color: var(--cyan);
}


/* =========================================================
   EXPLORE SHELL
   NOTE:
   Final Explore positioning is handled by explore.css.
   ========================================================= */

.explore-shell {
  position: relative;

  min-height: 100vh;

  display: grid;

  place-items: center;

  padding: 120px 24px 48px;
}


/* =========================================================
   LEGACY / SHARED SEARCH SYSTEM
   Final Explore version is overridden by explore.css.
   ========================================================= */

.search-wrapper {
  position: relative;

  width: min(820px, 80vw);

  z-index: 10;

  transition:
    all 0.34s ease;
}


.search-wrapper.is-active {
  position: fixed;

  top: 90px;
  left: 50%;

  transform: translateX(-50%);

  width: min(760px, 78vw);
}


#starSearch {
  width: 100%;

  height: 92px;

  border: 1px solid var(--line);

  background: rgba(255, 255, 255, 0.02);

  color: var(--ink);

  padding: 0 26px;

  font-size: clamp(30px, 4vw, 52px);

  line-height: 1;

  font-family: inherit;

  letter-spacing: 0.04em;

  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}


#starSearch::placeholder {
  color: rgba(234, 243, 255, 0.38);
}


#starSearch:focus {
  border-color:
    rgba(111, 231, 221, 0.74);

  box-shadow:
    0 0 0 1px
      rgba(111, 231, 221, 0.26),
    0 0 24px
      rgba(111, 231, 221, 0.1);
}


/* =========================================================
   SEARCH RESULTS
   ========================================================= */

.search-results {
  position: absolute;

  left: 0;
  right: 0;

  top: calc(100% + 12px);

  list-style: none;

  background:
    rgba(7, 12, 20, 0.92);

  border:
    1px solid var(--line);

  backdrop-filter: blur(12px);

  box-shadow:
    0 22px 56px
      rgba(0, 0, 0, 0.32);

  max-height: 360px;

  overflow-y: auto;
}


.search-results li {
  border-top:
    1px solid var(--line);
}


.search-results li:first-child {
  border-top: none;
}


.result-item {
  width: 100%;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 18px;

  padding: 16px 18px;

  background: transparent;

  border: none;

  color: var(--ink);

  text-align: left;

  cursor: pointer;

  transition:
    background 0.18s ease;
}


.result-item:hover,
.result-item:focus-visible {
  background:
    rgba(111, 231, 221, 0.06);

  outline: none;
}


.result-main {
  display: flex;

  align-items: center;

  gap: 12px;

  min-width: 0;
}


.result-dot {
  width: 10px;
  height: 10px;

  flex: 0 0 auto;

  border-radius: 50%;

  display: inline-block;

  box-shadow:
    0 0 12px currentColor;
}


.result-copy {
  min-width: 0;
}


.result-name {
  display: block;

  font-size: 13px;

  letter-spacing: 0.08em;

  text-transform: uppercase;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


.result-designation {
  display: block;

  font-size: 10px;

  color: var(--ink-soft);

  letter-spacing: 0.12em;

  margin-top: 5px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


.result-distance {
  color: var(--ink-soft);

  font-size: 10px;

  letter-spacing: 0.14em;

  white-space: nowrap;
}


/* =========================================================
   UTILITY
   ========================================================= */

.is-hidden {
  display: none !important;
}


/* =========================================================
   LEGACY HUD SYSTEM
   Final Explore HUD is overridden by explore.css.
   ========================================================= */

.hud-card {
  position: relative;

  z-index: 12;

  width: min(920px, 84vw);

  min-height: 440px;

  display: grid;

  grid-template-columns:
    minmax(260px, 1.1fr)
    minmax(330px, 1.25fr);

  background:
    rgba(7, 12, 20, 0.82);

  border:
    1px solid var(--line);

  box-shadow:
    0 28px 70px
      rgba(0, 0, 0, 0.45);

  backdrop-filter: blur(16px);

  opacity: 0;

  transform:
    translateY(40px)
    scale(0.98);

  pointer-events: none;

  transition:
    opacity 0.26s ease,
    transform 0.26s ease;
}


.hud-card.is-active {
  opacity: 1;

  transform:
    translateY(0)
    scale(1);

  pointer-events: auto;
}


.hud-visual {
  position: relative;

  display: grid;

  place-items: center;

  padding: 52px 28px 36px;

  border-right:
    1px solid var(--line);

  overflow: hidden;
}


.hud-visual::before,
.hud-visual::after {
  content: "";

  position: absolute;

  border-radius: 50%;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}


.hud-visual::before {
  width: 280px;
  height: 280px;
}


.hud-visual::after {
  width: 360px;
  height: 360px;
}


/* =========================================================
   PROCEDURAL STAR
   ========================================================= */

.procedural-star {
  --star-size: 180px;

  --star-color-1: #ffffff;
  --star-color-2: #4facfe;
  --star-color-3: #00f2fe;

  --star-glow:
    rgba(79, 172, 254, 0.8);

  width: var(--star-size);
  height: var(--star-size);

  aspect-ratio: 1 / 1;

  position: relative;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 32% 30%,
      var(--star-color-1) 12%,
      var(--star-color-2) 58%,
      var(--star-color-3) 100%
    );

  box-shadow:
    0 0 20px var(--star-glow),
    0 0 60px
      rgba(79, 172, 254, 0.26),
    inset -16px -18px 22px
      rgba(0, 0, 0, 0.12);

  transform: scale(1);

  animation:
    starPulse
    3.4s
    ease-in-out
    infinite
    alternate;
}


.procedural-star::before,
.procedural-star::after {
  content: "";

  position: absolute;

  border-radius: 50%;
}


.procedural-star::before {
  inset: -16px;

  border:
    1px solid
    rgba(255, 255, 255, 0.14);
}


.procedural-star::after {
  inset: -30px;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}


@keyframes starPulse {
  0% {
    transform: scale(0.96);

    filter:
      brightness(0.97)
      saturate(0.94);
  }

  100% {
    transform: scale(1.04);

    filter:
      brightness(1.12)
      saturate(1.16);
  }
}


/* =========================================================
   HUD CONTENT
   ========================================================= */

.hud-content {
  display: flex;

  flex-direction: column;

  justify-content: center;

  padding: 42px 32px 32px;
}


.hud-kicker {
  color: var(--cyan);

  font-size: 10px;

  letter-spacing: 0.32em;

  text-transform: uppercase;
}


.hud-content h1 {
  margin-top: 14px;

  font-size:
    clamp(36px, 4vw, 52px);

  font-weight: 700;

  line-height: 0.95;

  letter-spacing: -0.04em;
}


.hud-designation {
  margin-top: 10px;

  color: var(--ink-soft);

  font-size: 11px;

  letter-spacing: 0.18em;

  text-transform: uppercase;
}


.hud-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(120px, 1fr));

  gap: 18px;

  margin-top: 30px;
}


.metric {
  border-top:
    1px solid var(--line);

  padding-top: 12px;
}


.metric span {
  display: block;

  color: var(--ink-soft);

  font-size: 9px;

  letter-spacing: 0.22em;

  text-transform: uppercase;

  margin-bottom: 8px;
}


.metric strong {
  display: block;

  font-size:
    clamp(20px, 2vw, 28px);

  letter-spacing: -0.04em;

  color: var(--ink);
}


/* =========================================================
   GENERAL EXPLORE RESPONSIVE
   ========================================================= */

@media (max-width: 760px) {

  .topbar,
  .explore-header {
    padding: 22px 20px 0;
  }


  .nav-links,
  .explore-nav {
    gap: 14px;
  }


  .nav-links a,
  .nav-links a:visited,
  .explore-nav a,
  .explore-nav a:visited {
    font-size: 9px;

    letter-spacing: 0.12em;
  }


  .explore-shell {
    padding:
      90px
      14px
      30px;
  }


  /* Legacy search fallback */
  .search-wrapper,
  .search-wrapper.is-active {
    width:
      min(86vw, 520px);
  }


  .search-wrapper.is-active {
    top: 72px;
  }


  #starSearch {
    height: 74px;

    padding: 0 18px;
  }


  /* Legacy HUD fallback */
  .hud-card {
    grid-template-columns: 1fr;

    width:
      min(90vw, 560px);
  }


  .hud-visual {
    min-height: 220px;

    border-right: none;

    border-bottom:
      1px solid var(--line);

    padding:
      30px 18px 22px;
  }


  .hud-content {
    padding:
      30px 20px 28px;
  }


  .hud-grid {
    grid-template-columns:
      repeat(
        2,
        minmax(100px, 1fr)
      );

    gap:
      14px 12px;
  }
